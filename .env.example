# توکن ربات را از @BotFather بگیر
BOT_TOKEN=
# آیدی عددی خودت (از @userinfobot)
ADMIN_ID=

# شماره کارت و نام صاحب حساب برای نمایش به خریدار
CARD_NUMBER=6037-99xx-xxxx-xxxx
CARD_HOLDER=نام و نام خانوادگی

# حداقل دعوت برای جایزه (برای تست موقتاً کمش کن)
REFERRAL_TARGET=1
REFERRAL_REWARD_GB=5
REFERRAL_REWARD_DAYS=30

# اطلاعات پنل 3x-ui (فقط برای مهاجرت خودکار اولین پنل استفاده می‌شود؛ مدیریت از /panels)
XUI_BASE_URL=
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=1
XUI_SUB_BASE_URL=https://your-sub-domain

# مسیر فایل دیتابیس (روی Railway: /data/bot.db)
DATABASE_PATH=bot.db

# پروکسی SOCKS5 برای اجرا در ایران (روی Railway خالی بذار)
# مثال: socks5://127.0.0.1:10808
PROXY_URL=

# بکاپ خودکار روزانه روی گیت‌هاب (ریپوی خصوصی جدا از کد)
# یک Personal Access Token با دسترسی repo بساز: https://github.com/settings/tokens
GITHUB_BACKUP_REPO=username/backup-repo
GITHUB_TOKEN=
GITHUB_BACKUP_KEEP=14
